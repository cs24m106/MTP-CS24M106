<!-- Modified from IsaacGymEnvs amp_humanoid.xml v1.2.0 -->

<mujoco model="humanoid">
  <!-- ADDED: ensure large enough offscreen framebuffer for renderer -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
  </visual>
  
  <default>
    <default class="body">
      <geom condim="1" friction="1.0 0.05 0.05" solimp=".9 .99 .003" solref=".015 1"/>
      <joint type="hinge" limited="true" solimplimit="0 .99 .01"/>
    </default>
  </default>

  <!-- ADDED: grind env for world -->
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" conaffinity="1" size="100 100 .2" material="grid"/>
    <!-- ADDED: Tracking camera for rgb_array mode -->
    <camera name="track" mode="trackcom" pos="0 -4.5 3" xyaxes="1 0 0 0 0.5 1"/>

    <body name="pelvis" pos="0 0 1" childclass="body">
      <freejoint name="root"/>
      <geom name="pelvis" type="sphere" pos="0 0 0.07" size=".09" density="2226"/>
      <geom name="upper_waist" type="sphere" pos="0 0 0.205" size="0.07" density="2226"/>
      <body name="torso" pos="0 0 0.236151">
        <light name="top" pos="0 0 2" mode="trackcom"/>
        <!-- Abdomen joints -->
        <joint name="abdomen_x" pos="0 0 0" axis="1 0 0" range="-60 60" damping="60" armature=".025"/>
        <joint name="abdomen_y" pos="0 0 0" axis="0 1 0" range="-60 90" damping="60" armature=".025"/>
        <joint name="abdomen_z" pos="0 0 0" axis="0 0 1" range="-50 50" damping="60" armature=".025"/>
        <geom name="torso" type="sphere" pos="0 0 0.12" size="0.11" density="1794"/>

        <geom name="right_clavicle" type="capsule" fromto="-0.0060125 -0.0457775 0.2287955 -0.016835 -0.128177 0.2376182" size=".045" density="1100"/>
        <geom name="left_clavicle" type="capsule" fromto="-0.0060125 0.0457775 0.2287955 -0.016835 0.128177 0.2376182" size=".045" density="1100"/>

        <body name="head" pos="0 0 0.223894">
          <!-- Neck joints -->
          <joint name="neck_x" axis="1 0 0" range="-50 50" damping="5" armature=".017"/>
          <joint name="neck_y" axis="0 1 0" range="-40 60" damping="5" armature=".017"/>
          <joint name="neck_z" axis="0 0 1" range="-45 45" damping="5" armature=".017"/>
          <geom name="head" type="sphere" pos="0 0 0.175" size="0.095" density="1081"/>
        </body>

        <body name="right_upper_arm" pos="-0.02405 -0.18311 0.24350">
          <!-- Right Shoulder joints -->
          <joint name="right_shoulder_x" axis="1 0 0" range="-180 45" damping="20" armature=".02"/>
          <joint name="right_shoulder_y" axis="0 1 0" range="-180 60" damping="20" armature=".02"/>
          <joint name="right_shoulder_z" axis="0 0 1"  range="-90 90" damping="20" armature=".02"/>
          <geom name="right_upper_arm" type="capsule" fromto="0 0 -0.05 0 0 -0.23" size=".045" density="982"/>

          <body name="right_lower_arm" pos="0 0 -0.274788">
            <!-- Right Elbow joints -->
            <joint name="right_elbow" axis="0 1 0" range="-160 0" damping="15" armature=".015"/>
            <geom name="right_lower_arm" type="capsule" fromto="0 0 -0.0525 0 0 -0.1875" size="0.04" density="1056"/>

            <body name="right_hand" pos="0 0 -0.258947">
              <geom name="right_hand" type="sphere" size=".04" density="1865"/>
            </body>
          </body>
        </body>

        <body name="left_upper_arm" pos="-0.02405 0.18311 0.24350">
          <!-- Left Shoulder joints -->
          <joint name="left_shoulder_x" axis="1 0 0" range="-45 180" damping="20" armature=".02"/>
          <joint name="left_shoulder_y" axis="0 1 0" range="-180 60" damping="20" armature=".02"/>
          <joint name="left_shoulder_z" axis="0 0 1"  range="-90 90" damping="20" armature=".02"/>
          <geom name="left_upper_arm" type="capsule" fromto="0 0 -0.05 0 0 -0.23" size="0.045" density="982"/>

          <body name="left_lower_arm" pos="0 0 -0.274788">
            <!-- Left Elbow joints -->
            <joint name="left_elbow" axis="0 1 0" range="-160 0" damping="15" armature=".015"/>
            <geom name="left_lower_arm" type="capsule" fromto="0 0 -0.0525 0 0 -0.1875" size="0.04" density="1056"/>

            <body name="left_hand" pos="0 0 -0.258947">
              <geom name="left_hand" type="sphere" size=".04" density="1865"/>
            </body>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.084887 0">
        <!-- Right Hip joints -->
        <joint name="right_hip_x" axis="1 0 0" range="-60 15" damping="30" armature=".02"/>
        <joint name="right_hip_y" axis="0 1 0" range="-140 60" damping="30" armature=".02"/>
        <joint name="right_hip_z" axis="0 0 1" range="-60 35" damping="30" armature=".02"/>
        <geom name="right_thigh" type="capsule" fromto="0 0 -0.06 0 0 -0.36" size="0.055" density="1269"/>

        <body name="right_shin" pos="0 0 -0.421546">
          <!-- Right Knee joints -->
          <joint name="right_knee" pos="0 0 0" axis="0 1 0" range="0 160" damping="30" armature=".02"/>
          <geom name="right_shin" type="capsule" fromto="0 0 -0.045 0 0 -0.355"  size=".05" density="1014"/>

          <body name="right_foot" pos="0 0 -0.409870">
            <!-- Right Ankle joints -->
            <joint name="right_ankle_x" pos="0 0 0" axis="1 0 0" range="-30 30" damping="20" armature=".01"/>
            <joint name="right_ankle_y" pos="0 0 0" axis="0 1 0" range="-55 55" damping="20" armature=".01"/>
            <joint name="right_ankle_z" pos="0 0 0" axis="0 0 1" range="-40 40" damping="20" armature=".01"/>
            <geom name="right_foot" type="box" pos="0.045 0 -0.0225" size="0.0885 0.045 0.0275" density="1141"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.084887 0">
        <!-- Left Hip joints -->
        <joint name="left_hip_x" axis="1 0 0" range="-15 60" damping="30" armature=".02"/>
        <joint name="left_hip_y" axis="0 1 0" range="-140 60" damping="30" armature=".02"/>
        <joint name="left_hip_z" axis="0 0 1" range="-35 60" damping="30" armature=".02"/>
        <geom name="left_thigh" type="capsule" fromto="0 0 -0.06 0 0 -0.36" size=".055" density="1269"/>

        <body name="left_shin" pos="0 0 -0.421546">
          <!-- Left Knee joints -->
          <joint name="left_knee" pos="0 0 0" axis="0 1 0" range="0 160" damping="30" armature=".02"/>
          <geom name="left_shin" type="capsule" fromto="0 0 -0.045 0 0 -0.355"  size=".05" density="1014"/>

          <body name="left_foot" pos="0 0 -0.409870">
            <!-- Left Ankle joints -->
            <joint name="left_ankle_x" pos="0 0 0" axis="1 0 0" range="-30 30" damping="20" armature=".01"/>
            <joint name="left_ankle_y" pos="0 0 0" axis="0 1 0" range="-55 55" damping="20" armature=".01"/>
            <joint name="left_ankle_z" pos="0 0 0" axis="0 0 1" range="-40 40" damping="20" armature=".01"/>
            <geom name="left_foot" type="box" pos="0.045 0 -0.0225" size="0.0885 0.045 0.0275" density="1141"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name='abdomen_x           ' kp='600 ' joint='abdomen_x' ctrlrange='-1.0472 1.0472'/>
    <position name='abdomen_y           ' kp='600 ' joint='abdomen_y' ctrlrange='-1.0472 1.5708'/>
    <position name='abdomen_z           ' kp='600 ' joint='abdomen_z' ctrlrange='-0.8727 0.8727'/>
    <position name='neck_x              ' kp='50  ' joint='neck_x' ctrlrange='-0.8727 0.8727'/>
    <position name='neck_y              ' kp='50  ' joint='neck_y' ctrlrange='-0.6981 1.0472'/>
    <position name='neck_z              ' kp='50  ' joint='neck_z' ctrlrange='-0.7854 0.7854'/>
    <position name='right_shoulder_x    ' kp='200 ' joint='right_shoulder_x' ctrlrange='-3.1416 0.7854'/>
    <position name='right_shoulder_y    ' kp='200 ' joint='right_shoulder_y' ctrlrange='-3.1416 1.0472'/>
    <position name='right_shoulder_z    ' kp='200 ' joint='right_shoulder_z' ctrlrange='-1.5708 1.5708'/>
    <position name='right_elbow         ' kp='150 ' joint='right_elbow' ctrlrange='-2.7925 0.0000'/>
    <position name='left_shoulder_x     ' kp='200 ' joint='left_shoulder_x' ctrlrange='-0.7854 3.1416'/>
    <position name='left_shoulder_y     ' kp='200 ' joint='left_shoulder_y' ctrlrange='-3.1416 1.0472'/>
    <position name='left_shoulder_z     ' kp='200 ' joint='left_shoulder_z' ctrlrange='-1.5708 1.5708'/>
    <position name='left_elbow          ' kp='150 ' joint='left_elbow' ctrlrange='-2.7925 0.0000'/>
    <position name='right_hip_x         ' kp='300 ' joint='right_hip_x' ctrlrange='-1.0472 0.2618'/>
    <position name='right_hip_z         ' kp='300 ' joint='right_hip_z' ctrlrange='-1.0472 0.6109'/>
    <position name='right_hip_y         ' kp='300 ' joint='right_hip_y' ctrlrange='-2.4435 1.0472'/>
    <position name='right_knee          ' kp='300 ' joint='right_knee' ctrlrange='0.0000 2.7925'/>
    <position name='right_ankle_x       ' kp='200 ' joint='right_ankle_x' ctrlrange='-0.5236 0.5236'/>
    <position name='right_ankle_y       ' kp='200 ' joint='right_ankle_y' ctrlrange='-0.9599 0.9599'/>
    <position name='right_ankle_z       ' kp='200 ' joint='right_ankle_z' ctrlrange='-0.6981 0.6981'/>
    <position name='left_hip_x          ' kp='300 ' joint='left_hip_x' ctrlrange='-0.2618 1.0472'/>
    <position name='left_hip_z          ' kp='300 ' joint='left_hip_z' ctrlrange='-0.6109 1.0472'/>
    <position name='left_hip_y          ' kp='300 ' joint='left_hip_y' ctrlrange='-2.4435 1.0472'/>
    <position name='left_knee           ' kp='300 ' joint='left_knee' ctrlrange='0.0000 2.7925'/>
    <position name='left_ankle_x        ' kp='200 ' joint='left_ankle_x' ctrlrange='-0.5236 0.5236'/>
    <position name='left_ankle_y        ' kp='200 ' joint='left_ankle_y' ctrlrange='-0.9599 0.9599'/>
    <position name='left_ankle_z        ' kp='200 ' joint='left_ankle_z' ctrlrange='-0.6981 0.6981'/>
  </actuator>
</mujoco>